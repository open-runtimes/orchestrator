{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "orchestrator chart values",
  "description": "Every object is closed (additionalProperties: false) so a misspelled key fails the install instead of being silently ignored — most of this chart's values are consumed inside `with`/`if` blocks, which swallow typos. Free-form maps (node selectors, annotations, environment) stay open on purpose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobs",
    "deployments",
    "sandbox"
  ],
  "properties": {
    "global": {
      "description": "Helm injects a `global` key into every subchart's values, so a closed schema must allow it or the chart cannot be used as a dependency of an umbrella chart. Left open: its contents belong to the parent chart, not this one.",
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "$ref": "#/$defs/imagePullSecrets"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "listeners": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobSidecar": {
          "$ref": "#/$defs/image"
        },
        "workloadSidecar": {
          "$ref": "#/$defs/image"
        },
        "poolShim": {
          "$ref": "#/$defs/image"
        },
        "sandboxAgent": {
          "$ref": "#/$defs/image"
        },
        "csiRegistrar": {
          "$ref": "#/$defs/image"
        },
        "pullPolicy": {
          "$ref": "#/$defs/pullPolicy"
        }
      }
    },
    "workloadImagePullPolicy": {
      "$ref": "#/$defs/pullPolicy"
    },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "s3": {
          "$ref": "#/$defs/s3"
        },
        "httpRoute": {
          "$ref": "#/$defs/httpRoute"
        },
        "image": {
          "$ref": "#/$defs/pullableImage"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": {
          "$ref": "#/$defs/autoscaling"
        },
        "leaderElection": {
          "$ref": "#/$defs/leaderElection"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "podAnnotations": {
          "$ref": "#/$defs/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/$defs/stringMap"
        },
        "tolerations": {
          "$ref": "#/$defs/tolerations"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "serviceAccount": {
          "$ref": "#/$defs/serviceAccount"
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodeSelector": {
              "$ref": "#/$defs/stringMap"
            },
            "tolerations": {
              "$ref": "#/$defs/tolerations"
            },
            "cpuOvercommit": {
              "type": "number"
            },
            "memoryOvercommit": {
              "type": "number"
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "serviceAccount": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "create": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                },
                "imagePullSecrets": {
                  "$ref": "#/$defs/imagePullSecrets"
                }
              }
            },
            "podSecurityContext": {
              "type": "object"
            }
          }
        },
        "artifactEndpoint": {
          "type": "string"
        },
        "retention": {
          "$ref": "#/$defs/duration"
        },
        "maintenanceInterval": {
          "$ref": "#/$defs/duration"
        },
        "logFlushInterval": {
          "$ref": "#/$defs/duration"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        }
      }
    },
    "deployments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "s3": {
          "$ref": "#/$defs/s3"
        },
        "presignEndpoint": {
          "type": "string"
        },
        "httpRoute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "image": {
          "$ref": "#/$defs/pullableImage"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": {
          "$ref": "#/$defs/autoscaling"
        },
        "leaderElection": {
          "$ref": "#/$defs/leaderElection"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "podAnnotations": {
          "$ref": "#/$defs/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/$defs/stringMap"
        },
        "tolerations": {
          "$ref": "#/$defs/tolerations"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "serviceAccount": {
          "$ref": "#/$defs/serviceAccount"
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "gatewayNamespace": {
              "type": "string"
            }
          }
        },
        "workload": {
          "$ref": "#/$defs/workload"
        },
        "domain": {
          "type": "string"
        },
        "revisionWorkers": {
          "type": "integer",
          "minimum": 1
        },
        "clientQPS": {
          "type": "integer",
          "minimum": 1
        },
        "clientBurst": {
          "type": "integer",
          "minimum": 1
        },
        "limitRange": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "pools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pool"
          }
        },
        "activator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "$ref": "#/$defs/pullableImage"
            },
            "replicaCount": {
              "type": "integer",
              "minimum": 1
            },
            "autoscaling": {
              "$ref": "#/$defs/autoscaling"
            },
            "resources": {
              "$ref": "#/$defs/resources"
            },
            "podAnnotations": {
              "$ref": "#/$defs/stringMap"
            },
            "nodeSelector": {
              "$ref": "#/$defs/stringMap"
            },
            "tolerations": {
              "$ref": "#/$defs/tolerations"
            },
            "affinity": {
              "type": "object"
            },
            "priorityClassName": {
              "type": "string"
            },
            "serviceAccount": {
              "$ref": "#/$defs/serviceAccount"
            },
            "service": {
              "$ref": "#/$defs/service"
            },
            "podSecurityContext": {
              "type": "object"
            },
            "securityContext": {
              "type": "object"
            }
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "s3": {
          "$ref": "#/$defs/s3"
        },
        "presignEndpoint": {
          "type": "string"
        },
        "httpRoute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "image": {
          "$ref": "#/$defs/pullableImage"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": {
          "$ref": "#/$defs/autoscaling"
        },
        "leaderElection": {
          "$ref": "#/$defs/leaderElection"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "podAnnotations": {
          "$ref": "#/$defs/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/$defs/stringMap"
        },
        "tolerations": {
          "$ref": "#/$defs/tolerations"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "serviceAccount": {
          "$ref": "#/$defs/serviceAccount"
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "workload": {
          "$ref": "#/$defs/workload"
        },
        "domain": {
          "type": "string"
        },
        "scheme": {
          "enum": [
            "http",
            "https"
          ]
        },
        "pools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pool"
          }
        },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "$ref": "#/$defs/pullableImage"
            },
            "replicaCount": {
              "type": "integer",
              "minimum": 1
            },
            "autoscaling": {
              "$ref": "#/$defs/autoscaling"
            },
            "resources": {
              "$ref": "#/$defs/resources"
            },
            "podAnnotations": {
              "$ref": "#/$defs/stringMap"
            },
            "nodeSelector": {
              "$ref": "#/$defs/stringMap"
            },
            "tolerations": {
              "$ref": "#/$defs/tolerations"
            },
            "affinity": {
              "type": "object"
            },
            "priorityClassName": {
              "type": "string"
            },
            "serviceAccount": {
              "$ref": "#/$defs/serviceAccount"
            },
            "service": {
              "$ref": "#/$defs/service"
            },
            "holdSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "podSecurityContext": {
              "type": "object"
            },
            "securityContext": {
              "type": "object"
            }
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        }
      }
    },
    "poolController": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/pullableImage"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "leaderElection": {
          "$ref": "#/$defs/leaderElection"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "podAnnotations": {
          "$ref": "#/$defs/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/$defs/stringMap"
        },
        "tolerations": {
          "$ref": "#/$defs/tolerations"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "serviceAccount": {
          "$ref": "#/$defs/serviceAccount"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        }
      }
    },
    "mountAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/pullableImage"
        },
        "port": {
          "$ref": "#/$defs/port"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "podAnnotations": {
          "$ref": "#/$defs/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/$defs/stringMap"
        },
        "tolerations": {
          "$ref": "#/$defs/tolerations"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
