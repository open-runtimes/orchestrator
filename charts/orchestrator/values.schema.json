        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    }
  },
  "$defs": {
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "image",
        "port",
        "cpu",
        "memory"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "$ref": "#/$defs/port"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "cpu": {
          "type": "number",
          "minimum": 0
        },
        "memory": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeClass": {
          "enum": [
            "",
            "runc",
            "gvisor",
            "kata"
          ]
        },
        "burst": {
          "enum": [
            "cold",
            "reject"
          ]
        },
        "mounts": {
          "type": "boolean"
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "path"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "subPath": {
                "type": "string"
              },
              "readonly": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "LocalObjectReference entries. Names resolve in the namespace of the pod using them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "quantity": {
      "description": "Kubernetes quantity — a string like \"100m\"/\"200Gi\", or a bare number.",
      "type": [
        "string",
        "integer",
        "number"
      ]
    },
    "duration": {
      "description": "Go duration, e.g. 15m, 1s, 1h30m.",
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "pullPolicy": {
      "enum": [
        "",
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "description": "Fully overrides repository+tag when set — use for digests.",
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "pullableImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "$ref": "#/$defs/pullPolicy"
        }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "forcePathStyle": {
          "type": "boolean"
        },
        "accessKeyId": {
          "type": "string"
        },
        "secretAccessKey": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "profiles": {
          "type": "object",
          "description": "Named credential profiles, selected per artifact as s3://<name>@bucket/key.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "endpoint": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "forcePathStyle": {
                "type": "boolean"
              },
              "accessKeyId": {
                "type": "string"
              },
              "secretAccessKey": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "leaseName": {
          "type": "string"
        },
        "leaseDurationSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "renewDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "retryPeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/$defs/resourceList"
        },
        "limits": {
          "$ref": "#/$defs/resourceList"
        }
      }
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "$ref": "#/$defs/quantity"
        },
        "memory": {
          "$ref": "#/$defs/quantity"
        },
        "ephemeral-storage": {
          "$ref": "#/$defs/quantity"
        }
      }
    },
    "tolerations": {
      "type": "array",
      "description": "Standard pod-spec tolerations.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "operator": {
            "enum": [
              "Equal",
              "Exists"
            ]
          },
          "value": {
            "type": "string"
          },
          "effect": {
            "enum": [
              "",
              "NoSchedule",
              "PreferNoSchedule",
              "NoExecute"
            ]
          },
          "tolerationSeconds": {
            "type": "integer"
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "$ref": "#/$defs/stringMap"
        },
        "tolerations": {
          "$ref": "#/$defs/tolerations"
        },
        "cpuOvercommit": {
          "type": "number"
        },
        "memoryOvercommit": {
          "type": "number"
        },
        "podSecurityContext": {
          "type": "object"
        }
      }
    }
  }
}
